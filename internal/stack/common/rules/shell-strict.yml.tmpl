# pawl rule pack: code.dropped-results for shell. A script fails on the first failing command.
id: shell-strict-mode
language: Bash
severity: error
message: The script does not set strict mode; add `set -euo pipefail` after the shebang.
# strict mode is a `set` command with errexit (-e or -o errexit) and pipefail, in any spelling (-Eeuo, -o ...)
rule:
  kind: program
  not:
    has:
      stopBy: end
      kind: command
      all:
        - regex: '^set\s'
        - regex: '\s-[a-zA-Z]*e|errexit'
        - regex: 'pipefail'
files: ["**/*.sh", "**/*.bash"]
