# pawl: the nightly ring. Everything slow (mutation, audits, docs drift, ring budgets) on the whole tree.
# Project-owned: edit freely. A failure opens, or comments on, one issue titled "nightly failed".
name: nightly

on:
  schedule:
    - cron: "17 3 * * *"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: nightly
  cancel-in-progress: false

defaults:
  run:
    shell: bash

jobs:
  nightly:
    name: nightly
    runs-on: ubuntu-latest
    timeout-minutes: [[.NightlyTimeout]]
    permissions:
      contents: read
      issues: write # open or comment on the "nightly failed" issue
    env:
      PAWL_FULL: "1"
      PAWL_BASE: origin/[[.DefaultBranch]]
    steps:[[template "setup" .]]
      - name: make nightly
        run: make nightly
      - name: Report the failure
        if: failure()
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          TITLE: nightly failed
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: |
          number="$(gh issue list --state open --search "in:title ${TITLE}" --json number,title \
            --jq ".[] | select(.title == \"${TITLE}\") | .number" | head -n 1)"
          if [ -n "${number}" ]; then
            gh issue comment "${number}" --body "Failed again: ${RUN_URL}"
          else
            gh issue create --title "${TITLE}" --body "The nightly ring failed: ${RUN_URL}"
          fi
