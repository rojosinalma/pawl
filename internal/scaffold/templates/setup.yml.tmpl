[[define "setup"]]
      - uses: [[uses "actions/checkout"]]
        with:
          fetch-depth: 0
          persist-credentials: false
[[- if .Go]]
      - uses: [[uses "actions/setup-go"]]
        with:
          go-version-file: go.mod
[[- end]]
[[- if .Ruby]]
      - uses: [[uses "ruby/setup-ruby"]]
        with:
          bundler-cache: true
[[- end]]
[[- if .UV]]
      - uses: [[uses "astral-sh/setup-uv"]]
[[- end]]
[[- if .Bun]]
      - uses: [[uses "oven-sh/setup-bun"]]
[[- if .BunVersionFile]]
        with:
          bun-version-file: [[.BunVersionFile]]
[[- end]]
[[- end]]
[[- if .Rust]]
      - name: Install the Rust toolchain of rust-toolchain.toml
        run: rustup toolchain install
[[- end]]
      - uses: [[uses "jdx/mise-action"]]
[[- if .PawlUses]]
      - name: Set up Pawl
        uses: [[.PawlUses]]
[[- else]]
      # A development build of pawl wrote this step; a release build pins the rojosinalma/pawl action instead.
      - name: Set up Pawl
        env:
          PAWL_RELEASE: [[.PawlRelease]]
          PAWL_ASSET: [[.PawlAsset]]
        run: |
          set -euo pipefail
          dir="${RUNNER_TEMP}/pawl"
          mkdir -p "${dir}/bin"
          curl -fsSL --retry 3 -o "${dir}/${PAWL_ASSET}" "${PAWL_RELEASE}/${PAWL_ASSET}"
          curl -fsSL --retry 3 -o "${dir}/checksums.txt" "${PAWL_RELEASE}/checksums.txt"
          # check the archive against its own line, so a missing line fails instead of passing vacuously
          if ! awk -v f="${PAWL_ASSET}" '$2 == f { print; found = 1 } END { exit !found }' "${dir}/checksums.txt" > "${dir}/asset.sha256"; then
            echo "::error::checksums.txt has no line for ${PAWL_ASSET}"
            exit 1
          fi
          (cd "${dir}" && sha256sum -c asset.sha256)
          tar -xzf "${dir}/${PAWL_ASSET}" -C "${dir}/bin" pawl
          echo "${dir}/bin" >> "${GITHUB_PATH}"
          "${dir}/bin/pawl" --version
[[- end]]
[[- if .Bun]]
      - name: Install dependencies
        run: bun install --frozen-lockfile
[[- end]]
[[- end]]
