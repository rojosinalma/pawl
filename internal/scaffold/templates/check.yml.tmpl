# pawl: the check ring. `make check` is the merge gate; `make coverage` checks the changed lines.
# Project-owned: edit freely. Runs on pull requests, on the default branch and in a merge queue.
name: check

on:
  pull_request:
  push:
    branches:
      - [[.DefaultBranch]]
  merge_group:

permissions:
  contents: read

concurrency:
  group: check-${{ github.ref }}
  cancel-in-progress: true

defaults:
  run:
    shell: bash

jobs:
  check:
    name: check
    runs-on: ubuntu-latest
    timeout-minutes: [[.CheckTimeout]]
    env:
      PAWL_BASE: origin/${{ github.base_ref || '[[.DefaultBranch]]' }}
    steps:[[template "setup" .]]
      - name: make check
        run: make check
      - name: make coverage
        run: make coverage
      - name: Annotate the findings
        if: failure()
        run: pawl check --format github
