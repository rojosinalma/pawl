# EditorConfig written by pawl. shfmt reads its options from here (indent, case indent, binary operators).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{sh,bash}]
shell_variant = bash
binary_next_line = true
switch_case_indent = true
space_redirects = false

[*.py]
indent_size = 4

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
