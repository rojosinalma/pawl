# pawl init appends this group once the Gemfile step lands; until then the fixture adds it itself.
grep -q "'rubocop'" Gemfile || cat >> Gemfile <<'GEMS'

group :development, :test do
  gem 'bundler-audit', '0.9.3', require: false
  gem 'rubocop', '1.92.2', require: false
  gem 'rubocop-minitest', '0.41.0', require: false
  gem 'rubocop-performance', '1.27.0', require: false
  gem 'simplecov', '1.3.2', require: false
  gem 'simplecov-lcov', '0.9.0', require: false
end
GEMS
bundle install --quiet
